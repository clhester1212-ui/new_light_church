<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- At login: Francis, the Slack bot (PC: Startup-folder shortcut). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.newlightchurch.francis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/slackbot/francis.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__REPO__/work/launchd-francis.log</string>
  <key>StandardErrorPath</key><string>__REPO__/work/launchd-francis.log</string>
</dict>
</plist>
